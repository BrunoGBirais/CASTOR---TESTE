# ================================================================
#  deploy/.env  — execução LOCAL dos scripts de deploy
# ================================================================
#  cp deploy/.env.example deploy/.env  e preencha.
#  Este arquivo NÃO é versionado (.gitignore cobre .env*).
#  Em CI nada disto existe: os valores vêm dos GitHub Secrets.
#  Variáveis reais de ambiente sempre têm precedência sobre o arquivo.
# ================================================================


# ════════════════════════════════════════════════════════════════
#  OBRIGATÓRIAS (7)
# ════════════════════════════════════════════════════════════════

# URL base do n8n, SEM barra no final.
# Também é a origem do VITE_API_BASE do front (N8N_URL + "/webhook").
N8N_URL=

# n8n → Settings → API → Create an API key
N8N_API_KEY=

# ── n8n: credenciais e pastas ───────────────────────────────────
# Login do owner. Necessário para listar credenciais por nome (/rest) e para
# criar/mover pastas. Sem ele, use N8N_CREDENTIAL_IDS abaixo.
N8N_EMAIL=
N8N_PASSWORD=

# URL base do Supabase, SEM barra no final.
# Serve às migrations E ao build do front (VITE_SUPABASE_URL).
SUPABASE_URL=

# service_role — só o deploy usa (migrations). NUNCA vai para o bundle.
SUPABASE_SERVICE_ROLE_KEY=

# anon — vai para o bundle do front (VITE_SUPABASE_ANON_KEY). É pública por
# definição; quem protege os dados é a RLS. O build recusa uma service_role.
SUPABASE_ANON_KEY=


# ════════════════════════════════════════════════════════════════
#  OPCIONAIS
# ════════════════════════════════════════════════════════════════


# Alternativa ao login: cookie n8n-auth + o browser-id que o gerou.
N8N_COOKIE=
N8N_BROWSER_ID=

# Mapa nome-da-credencial → id, para quando não houver login /rest.
# Os nomes são os que deploy/clean-credentials.mjs lista no final.
# N8N_CREDENTIAL_IDS={"Supabase_database":"jFje...","Supabase account":"i5Q8..."}
N8N_CREDENTIAL_IDS=

# Projeto de destino (default: personal).
N8N_PROJECT_ID=

# ── Supabase: fallback das migrations ───────────────────────────
# Conexão direta ao Postgres (exige psql no PATH).
# ⚠ É o Postgres DENTRO do Supabase (<slug>-supabase-db:5432 / database postgres),
#   não o Postgres genérico da stack.
SUPABASE_DB_URL=

# ── Front ───────────────────────────────────────────────────────
# Não há variável VITE_*: o build deriva as três que o Vite consome das
# obrigatórias acima —
#   VITE_API_BASE          = N8N_URL + "/webhook"
#   VITE_SUPABASE_URL      = SUPABASE_URL
#   VITE_SUPABASE_ANON_KEY = SUPABASE_ANON_KEY
# Preencha API_BASE só se os webhooks não estiverem em N8N_URL + "/webhook".
API_BASE=

# ── Caminhos e nomes ────────────────────────────────────────────
# Tudo é detectado sozinho no layout padrão. Preencha só se o projeto fugir
# dele — são estas variáveis que deixam a pasta deploy/ reutilizável.

# Pasta do front. Auto: 1ª com package.json entre
# front-react, frontend, front, web, client, app.
FRONT_DIR=

# JSON do static server. Auto: o único workflows/*static*server*.json.
STATIC_WORKFLOW=

# Nome do workflow e path do webhook do static server. Auto: o que o JSON
# já tinha (regerar nunca muda a URL publicada).
STATIC_WORKFLOW_NAME=
STATIC_WEBHOOK_PATH=

# Pasta e tabela de controle das migrations.
MIGRATIONS_DIR=
MIGRATIONS_TABLE=
